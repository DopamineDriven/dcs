    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsgo --noEmit",
    "test:vitest": "vitest",
    "test": "node --test --import tsx --test-reporter spec \"src/**/*.test.ts\"",
    "typegen": "next typegen"
  },
