{
  "extends": "@dcs/tsconfig/node-pkg.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "declarationMap": false,
    "sourceMap": false,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "types": ["*"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
