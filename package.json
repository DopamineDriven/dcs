{
  "name": "@dcs/root",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "scripts": {
    "build:eslint": "turbo build --filter=@dcs/eslint-config",
    "build:prettier": "turbo build --filter=@dcs/prettier-config",
    "build:ui": "turbo build --filter=@dcs/ui",
    "build:web": "turbo build --filter=@dcs/web",
    "build:types": "turbo build --filter=@dcs/types",
    "build:vitest": "turbo build --filter=@dcs/vitest-config",
    "build:targeted": "pnpm build:eslint && pnpm build:prettier && pnpm build:vitest && pnpm build:types && pnpm build:ui",
    "changeset": "changeset",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev --parallel --continue",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,mjs,cjs,json,yaml,yml,css,html,md,mdx}\" --ignore-unknown --cache",
    "lint": "turbo lint",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "clean:house": "bash ./manage.sh clean:house",
    "postclean:house": "pnpm --filter=@dcs/web typegen",
    "list:packages": "bash ./manage.sh list",
    "generate:base64": "openssl rand -base64 64",
    "generate:hex": "openssl rand -hex 64",
    "run:web": "turbo dev --filter=@dcs/web"
  },
  "devDependencies": {
    "@dcs/prettier-config": "workspace:*",
    "@biomejs/biome": "catalog:biome",
    "@changesets/cli": "catalog:utils",
    "@d0paminedriven/turbogen": "catalog:dd",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo",
    "dotenv": "catalog:dotenv",
    "eslint": "catalog:eslint",
    "husky": "catalog:utils",
    "prettier": "catalog:prettier",
    "tsx": "catalog:tsx",
    "turbo": "catalog:turbo",
    "typescript": "catalog:ts"
  },
  "prettier": "@dcs/prettier-config",
  "engines": {
    "node": ">=24",
    "npm": ">=10",
    "pnpm": ">=9"
  }
}
